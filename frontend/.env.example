# Frontend Astro de DonemosSC — variables públicas (bakeadas en build).
# Copiar a frontend/.env.local y ajustar. Nunca commitear frontend/.env*.

# URL base de la API backend NestJS.
# En dev local: http://localhost:3001/api/v1
# En producción: usar la URL pública HTTPS del backend.
PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
