# Backend NestJS de DonemosSC — configuración local de desarrollo.
# Copiar a backend/.env y ajustar. Nunca commitear backend/.env* (ver .gitignore).
# Los valores de producción viven en GitHub Secrets, no en el repo.

# PostgreSQL 16 local vía docker-compose (usuario donemos, base donemos).
DATABASE_URL=postgresql://donemos:donemos@localhost:5432/donemos?schema=public

# Secreto HS256 para firmar JWTs de sesión admin. En prod: rotar cada 90 días.
JWT_SECRET=cambiar-en-produccion-mínimo-32-caracteres

# Credenciales del único admin del MVP. En prod: cambiar en el primer boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-en-produccion

# Pepper para hash HMAC-SHA256 usado en la anonimización a 90 días (research §7).
# Debe rotarse con cuidado — al rotarlo, los registros anonimizados previos
# quedan aislados (comportamiento deseado). No compartir entre entornos.
REDACTION_PEPPER=cambiar-en-produccion-mínimo-32-caracteres

# Puerto HTTP del backend.
PORT=3001
