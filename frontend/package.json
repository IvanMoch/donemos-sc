{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio público mobile-first de DonemosSC — Astro + Tailwind + islas React puntuales.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro dev",
    "astro": "astro",
    "lint": "eslint --max-warnings=0 . && astro check",
