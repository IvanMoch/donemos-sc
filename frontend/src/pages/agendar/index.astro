---
// Página /agendar — hospeda el wizard de agendamiento (T080).
//
// Esta página NO está prerenderizada: se sirve SSR para poder consultar el
// estado del kill switch en el servidor antes de renderizar (research §5).
// Si `appointmentsDisabled=true`, redirigimos a /kill-switch-activo (SC-005).

import BaseLayout from '../../layouts/BaseLayout.astro';
import { WizardShell } from '../../components/wizard/WizardShell';
import { publicApi } from '../../lib/api';
import '../../styles/wizard.css';
import '../../styles/print.css';

// SSR: si el kill switch está activo, redirigimos antes de renderizar.
// Fallo tolerante y con timeout corto: si el backend no responde en 300ms,
// dejamos pasar y mostramos el wizard — no queremos bloquear LCP en producción
// por un backend lento, y el POST /appointments devolverá 503 apenas el donante
// intente confirmar (el UI lo maneja).
const SYSTEM_STATUS_TIMEOUT_MS = 300;
try {
  const status = await Promise.race([
    publicApi.getSystemStatus(),
    new Promise<null>((resolve) => setTimeout(() => resolve(null), SYSTEM_STATUS_TIMEOUT_MS)),
  ]);
  if (status?.appointmentsDisabled) {
    return Astro.redirect('/kill-switch-activo');
  }
} catch (_err) {
  // Silencioso a propósito — ver comentario arriba.
}
---

<BaseLayout
  title="Agendar cita — DonemosSC"
  description="Elegí tu horario y agendá tu cita para donar sangre en el Banco de Sangre del Hospital Central de San Cristóbal."
>
  {/* client:load porque el wizard es interactivo desde el primer render.
      client:idle daría FID mejor pero rompería la percepción de
      inmediatez en el paso intro. */}
  <WizardShell client:load />
</BaseLayout>
